APP_NAME="Конвертер"
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=warning

# Keep the existing reverse-DNS identifier used by installed APKs.
NATIVEPHP_APP_ID=by.ilya1420.currencyconverter
NATIVEPHP_APP_VERSION=1.0.0
NATIVEPHP_APP_VERSION_CODE=2

# Enable these only for a tested release build.
NATIVEPHP_ANDROID_MINIFY_ENABLED=true
NATIVEPHP_ANDROID_SHRINK_RESOURCES=true
